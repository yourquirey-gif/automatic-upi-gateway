{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.omniupi.in/sitemap.xml"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "https://api.omniupi.in/sitemap-pages.xml"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "https://api.omniupi.in/sitemap-blog.xml"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog-post.html"
    }
  ]
}
