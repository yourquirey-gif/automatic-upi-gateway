# OmniUPI public API URL used in generated payment_url values.
# Deploy the backend on the api.omniupi.in subdomain.
PUBLIC_API_BASE_URL=https://api.omniupi.in

# Public merchant website / hosted checkout origin.
PUBLIC_WEB_BASE_URL=https://omniupi.in

# Required for signing login/session JWTs. Use a long random secret in Render.
JWT_SECRET=replace-with-a-long-random-secret

# Secure first-admin bootstrap. Set these in the backend hosting provider's Environment Variables,
# never in GitHub/frontend source. The admin account is permanent and never needs a subscription.
ADMIN_NAME=Ayush Raj
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Enable the existing Gmail payment verifier.
GMAIL_AUTO_SYNC=true
GMAIL_SYNC_INTERVAL_MS=60000
