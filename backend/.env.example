# Public URL used in generated payment_url values.
# This must be the public BACKEND/API URL (not the GitHub Pages frontend URL).
PUBLIC_API_BASE_URL=https://seox.mooo.com

# Required for signing login/session JWTs. Use a long random secret in Render.
JWT_SECRET=replace-with-a-long-random-secret

# Secure first-admin bootstrap. Set these in the backend hosting provider's Environment Variables,
# never in GitHub/frontend source. The admin password can be changed later from Admin Management.
ADMIN_NAME=Administrator
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Enable the existing Gmail payment verifier.
GMAIL_AUTO_SYNC=true
GMAIL_SYNC_INTERVAL_MS=60000
