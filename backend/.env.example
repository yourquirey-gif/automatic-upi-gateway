# OmniUPI public API URL used in generated payment_url values.
PUBLIC_API_BASE_URL=https://api.omniupi.in

# Public merchant website / hosted checkout origin.
PUBLIC_WEB_BASE_URL=https://omniupi.in

# Required for signing login/session JWTs. Use a long random secret in Render.
JWT_SECRET=replace-with-a-long-random-secret

# Encrypt Google/Gmail OAuth refresh tokens and OAuth client secret at rest.
# Keep this only in the backend hosting provider.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret

# Optional environment fallback. Preferred production configuration is Admin > Gateway Settings.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.omniupi.in/api/v1/auth/google/callback

# Secure first-admin bootstrap. Set these in the backend hosting provider's Environment Variables,
# never in GitHub/frontend source. The admin account is permanent and never needs a subscription.
ADMIN_NAME=Ayush Raj
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional worker fallback. Admin > Gateway Settings can control Gmail auto-sync from MongoDB.
GMAIL_AUTO_SYNC=true
GMAIL_SYNC_INTERVAL_MS=60000
